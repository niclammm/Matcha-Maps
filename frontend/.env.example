# Postgres connection string (Neon). Use the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Shared password gate -- anyone visiting the site enters this once and gets
# a signed cookie. Not per-user auth, just keeps the site private to the two
# of you.
SHARED_PASSWORD="change-me"

# Vercel Blob (photo uploads). Created automatically when you enable Blob on
# the Vercel project; paste its token here for local dev.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
